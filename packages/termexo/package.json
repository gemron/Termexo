{
  "name": "termexo",
  "version": "0.12.0",
  "description": "Run the Termexo AI development workspace directly from npm on Windows, macOS and Linux",
  "type": "module",
  "bin": {
    "termexo": "bin/termexo.js"
  },
  "files": [
    "bin/",
    "lib/",
    "vendor/win32-x64/termexo.exe",
    "vendor/win32-x64/conpty.dll",
    "vendor/win32-x64/OpenConsole.exe",
    "vendor/darwin-arm64/Termexo.app.tar.gz",
    "vendor/darwin-x64/Termexo.app.tar.gz",
    "vendor/win32-x64/one-ring/",
    "!vendor/win32-x64/one-ring/runtime/node.exe",
    "vendor/linux-x64/Termexo.tar.gz",
    "README.md"
  ],
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "prepack": "node scripts/verify-payload.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "termexo",
    "terminal",
    "ai",
    "agent",
    "claude",
    "codex",
    "desktop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gemron/Termexo.git",
    "directory": "packages/termexo"
  },
  "homepage": "https://www.termexo.com/",
  "bugs": {
    "url": "https://github.com/gemron/Termexo/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
