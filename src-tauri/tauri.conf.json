{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termexo",
  "version": "0.2.2",
  "identifier": "dev.agentdock.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix apps/desktop-ui start -- --host 127.0.0.1 --port 4200",
    "devUrl": "http://127.0.0.1:4200",
    "beforeBuildCommand": "npm --prefix apps/desktop-ui run build",
    "frontendDist": "../apps/desktop-ui/dist/desktop-ui/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Termexo",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first workspace for AI coding agents, models, and terminals",
    "longDescription": "Coordinate AI coding terminals, native agent sessions, model providers, and recoverable project workspaces from one local-first desktop control plane.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
