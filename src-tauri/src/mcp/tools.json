  {
    "name": "project_preview_open",
    "group": "terminal",
    "description": "Open and select a Content Preview tab alongside terminal tabs. Shows project files/directories READ-ONLY: syntax-highlighted UTF-8 code/text (preserving source whitespace), Markdown, images and PDF. Optional line/column jumps to source. Creates a new independent tab by default; pass a returned tabId to update that specific tab. Returns the actual tabId; does not create a PTY or edit files. Paths must stay inside the selected project.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "tabId": {
          "type": "string",
          "description": "Optional existing preview tab ID from a prior call. Omit to create a new independent tab; the tab must belong to workspaceId."
        }
      },
      "required": ["workspaceId", "path"],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
