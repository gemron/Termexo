{
  "name": "termexo",
  "version": "0.4.5",
  "description": "Local-first workspace for AI coding agents, models, and terminals",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "npm --prefix apps/desktop-ui start -- --host 127.0.0.1 --port 4200",
    "build": "npm --prefix apps/desktop-ui run build",
    "capture:readme": "npm --prefix apps/desktop-ui run capture:readme",
    "test": "npm --prefix apps/desktop-ui test -- --watch=false",
    "npm:pack": "npm pack ./packages/termexo --dry-run",
    "npm:publish": "npm publish ./packages/termexo --access public",
    "npm:test": "npm --prefix packages/termexo test",
    "tauri:dev": "scripts\\tauri-msvc.cmd dev",
    "tauri:build": "scripts\\tauri-msvc.cmd build"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
